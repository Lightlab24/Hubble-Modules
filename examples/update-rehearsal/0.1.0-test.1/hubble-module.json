{
  "formatVersion": 1,
  "id": "hubble-update-rehearsal",
  "name": "Update rehearsal (simulation only)",
  "version": "0.1.0-test.1",
  "apiVersion": 1,
  "host": {
    "minMajor": 2,
    "maxMajor": 2
  },
  "configVersion": 1,
  "entry": "module.mjs",
  "files": [
    "module.mjs"
  ],
  "capabilities": [
    "simulation"
  ],
  "settings": [
    {
      "id": "initialState",
      "label": "Initial state",
      "required": true,
      "type": "boolean",
      "default": false
    }
  ],
  "actions": [
    {
      "id": "set-state",
      "label": "Set simulated state",
      "description": "Changes only this simulated instance.",
      "fields": [
        {
          "id": "active",
          "label": "Active",
          "required": true,
          "type": "boolean",
          "default": true
        }
      ],
      "completion": "local",
      "timeoutMs": 1000
    }
  ],
  "feedback": [
    {
      "id": "active",
      "label": "Simulated state",
      "description": "The last observed local simulation state.",
      "fields": []
    }
  ]
}
