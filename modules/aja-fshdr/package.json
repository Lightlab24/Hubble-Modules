{
  "name": "@hubble-module/aja-fshdr",
  "version": "2.1.7",
  "private": true,
  "type": "module",
  "description": "AJA FS-HDR control using Hubble spreadsheet controls",
  "hubble": {
    "id": "aja-fshdr",
    "name": "AJA FS-HDR",
    "assets": [
      "ui/index.html",
      "ui/logo.svg",
      "ui/icon.svg"
    ],
    "frontend": {
      "ui/app.js": "src/frontend.ts"
    }
  },
  "scripts": {
    "build": "hubble-module build .",
    "test": "hubble-module test .",
    "typecheck": "tsc --noEmit",
    "package": "hubble-module build . && hubble-module test . && hubble-module pack . ../../artifacts/aja-fshdr-2.1.7.hubble-module"
  },
  "dependencies": {
    "@hubble/module-sdk": "workspace:1.8.0"
  },
  "devDependencies": {
    "@hubble/module-tools": "workspace:1.5.0",
    "@types/node": "22.19.17",
    "typescript": "6.0.3"
  }
}
