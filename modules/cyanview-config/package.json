{
  "name": "@hubble-module/cyanview-config",
  "version": "0.1.59",
  "private": true,
  "type": "module",
  "hubble": {
    "id": "lightlab-cyanview-config",
    "name": "Cyanview",
    "frontend": {
      "ui/app.js": "src/frontend.ts"
    },
    "helpers": {
      "helpers/ping.mjs": "src/ping-helper.ts"
    },
    "assets": [
      "ui/index.html",
      "ui/logo.svg"
    ]
  },
  "scripts": {
    "generate:ui": "node -e \"import('./tools/adapt-ui.mjs').then(m=>m.buildUiAdapter())\"",
    "build": "pnpm generate:ui && hubble-module build .",
    "test": "pnpm generate:ui && hubble-module test .",
    "package": "pnpm generate:ui && hubble-module build . && hubble-module test . && hubble-module pack . ../../artifacts/lightlab-cyanview-config-0.1.50.hubble-module",
    "test:ui": "playwright test --config playwright.config.ts",
    "preview": "tsx tools/preview.ts"
  },
  "dependencies": {
    "@hubble/module-sdk": "workspace:1.8.0",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@hubble/module-tools": "workspace:1.5.0",
    "@playwright/test": "1.61.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
