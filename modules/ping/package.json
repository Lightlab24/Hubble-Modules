{
  "name": "@hubble-module/ping",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Pings network devices, keeps a timeline of each one and alerts when one drops or slows",
  "hubble": {
    "id": "network-ping",
    "name": "Ping",
    "assets": [
      "ui/index.html",
      "ui/ping.svg"
    ],
    "frontend": {
      "ui/app.js": "src/frontend.ts"
    }
  },
  "scripts": {
    "build": "hubble-module build .",
    "test": "hubble-module test .",
    "typecheck": "tsc --noEmit",
    "package": "hubble-module build . && hubble-module test . && hubble-module pack . ../../artifacts/ping-0.1.1.hubble-module",
    "preview": "tsx tools/preview.ts"
  },
  "dependencies": {
    "@hubble/module-sdk": "workspace:1.8.0"
  },
  "devDependencies": {
    "@hubble/module-tools": "workspace:1.5.0",
    "@types/node": "22.19.17",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
