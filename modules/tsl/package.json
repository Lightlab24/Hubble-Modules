{
  "name": "@hubble-module/tsl",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "hubble": {
    "id": "hubble-tsl",
    "name": "TSL Tally",
    "assets": [
      "ui/index.html",
      "ui/tsl.svg"
    ],
    "frontend": {
      "ui/app.js": "src/frontend.ts"
    }
  },
  "scripts": {
    "build": "hubble-module build .",
    "test": "hubble-module test .",
    "package": "hubble-module build . && hubble-module test . && hubble-module pack . ../../artifacts/hubble-tsl-1.4.3.hubble-module",
    "preview": "tsx tools/preview.ts",
    "test:ui": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@hubble/module-sdk": "workspace:1.8.0",
    "@hubble/module-contracts": "workspace:1.0.0",
    "@hubble/module-runtime-helpers": "workspace:1.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hubble/module-tools": "workspace:1.5.0",
    "@playwright/test": "1.61.1"
  },
  "description": "Receives TSL tally, shows what a switcher sends, and sets a Ross switcher to send it here"
}
