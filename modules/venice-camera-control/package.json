{
  "name": "@hubble-module/venice-camera-control",
  "version": "0.1.27",
  "private": true,
  "type": "module",
  "description": "Sony VENICE 2 camera control using Hubble spreadsheet controls",
  "hubble": {
    "id": "venice-camera-control",
