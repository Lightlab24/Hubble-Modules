{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "modules/**/*.ts",
    "packages/**/*.ts",
    "modules/**/*.tsx",
    "packages/**/*.tsx",
    "test/fixtures/**/*.ts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules"
  ]
}
