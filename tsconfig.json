{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["modules/**/*.ts", "packages/**/*.ts"],
  "exclude": ["**/dist", "**/node_modules"]
}
